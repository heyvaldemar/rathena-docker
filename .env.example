# Copy to .env, change the passwords, then run ./render-conf.sh

# --- images ------------------------------------------------------------------
# The tag names the era, the packet version, the rAthena commit AND the base.
# All four change what you get; leaving any of them out of the name means two
# different servers can end up sharing one tag.
RA_IMAGE_TAG=rathena:prere-20200401-a3.24
RA_DB_IMAGE_TAG=mariadb:11.8
RA_PW_IMAGE_TAG=rathena-webpw:1
RA_TIMEZONE=UTC

# --- addresses ---------------------------------------------------------------
# RA_PUBLIC_IP is handed to the client by the login server as "now go here", and
# Ragnarok carries a 32-bit address in that packet. IT MUST BE NUMERIC: a
# hostname is accepted by the config parser and then quietly breaks the hand-off,
# leaving the client stuck after account login with nothing in the log.
RA_PUBLIC_IP=203.0.113.10

# Service names on the compose network. Only change these if you rename services.
RA_DB_HOST=db
RA_LOGIN_HOST=login
RA_CHAR_HOST=char

# --- database ----------------------------------------------------------------
RA_DB_NAME=ragnarok
RA_DB_USER=ragnarok
RA_DB_PASSWORD=change-me
RA_DB_ROOT_PASSWORD=change-me-too

# --- inter-server credentials ------------------------------------------------
# ⚠ 23 CHARACTERS OR FEWER. The inter-server password is read into a fixed
# 24-byte buffer, so a longer one is silently truncated on the server side while
# the database keeps the whole thing — and the login server then reports only
# "Invalid password" for an account whose name it just echoed back correctly.
# Measured: a 24-character password was refused, its first 23 accepted.
RA_INTER_USER=s_srv
RA_INTER_PASS=change-me-max-23

# --- shard -------------------------------------------------------------------
RA_SERVER_NAME=MyShard

# Percent, so 2000 = 20x. Cards stay at 100 deliberately: gear should flow, MVP
# cards should stay rare, or there is nothing left to want after the first week.
RA_BASE_EXP_RATE=2000
RA_JOB_EXP_RATE=2000
RA_DROP_RATE=1000
RA_CARD_RATE=100

# --- password page -----------------------------------------------------------
# The ceiling of 23 is rAthena's, from src/login/login.hpp — a longer password is
# one the game client cannot send.
# Optional link shown at the foot of the password page. Leave empty for none.
RA_SITE_URL=
RA_PW_MIN_LENGTH=8
RA_PW_RATE_MAX=5
RA_PW_RATE_WINDOW=900
